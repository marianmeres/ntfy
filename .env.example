# Defaults for the `mmntfy` CLI. The library never reads these — pass options explicitly,
# or hand them in yourself with `createNtfy(optionsFromEnv(Deno.env.get))`.
#
# The real environment always wins over a file loaded with --env-file.

# Target topic. Also accepts a full target, which makes every other variable optional:
#   NTFY_TOPIC=https://ntfy.example.com/alerts
NTFY_TOPIC=my-secret-example-namespace-alerts

# Base URL of the ntfy server. Default: https://ntfy.sh
# NTFY_SERVER=https://ntfy.example.com

# Access token (publish-only is enough, and is what you want).
# NTFY_TOKEN=tk_AgQdq7mVBoFD37zQVN29RhuMzNIz2

# ...or basic auth, if your server uses it.
# NTFY_USERNAME=alice
# NTFY_PASSWORD=s3cret

# Defaults applied to every message unless a flag overrides them.
# NTFY_PRIORITY=default
# NTFY_TAGS=robot
# NTFY_TITLE=
# NTFY_ICON=
# NTFY_CLICK=

# Milliseconds before a send is abandoned. Default: 10000
# NTFY_TIMEOUT=10000
