{
  "name": "@marianmeres/ntfy",
  "version": "0.3.0",
  "description": "One function and one command (mmntfy) to publish an ntfy notification: the whole publish API, validated locally before anything is sent, never throws by default.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "bin": {
    "mmntfy": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/ntfy.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/ntfy/issues"
  },
  "homepage": "https://github.com/marianmeres/ntfy#readme",
  "keywords": [
    "ntfy",
    "notification",
    "push",
    "notify",
    "alert",
    "cli"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "test:deno": "CLI_RUNTIME=deno deno test -A --no-check --no-lock --config jsr.json tests/",
    "cli": "node src/bin.ts",
    "send": "node --env-file=.env src/bin.ts",
    "smoke": "pnpm run build && node scripts/smoke-npm.ts",
    "jsr:check": "deno publish --dry-run --allow-dirty --no-check --set-version \"$npm_package_version\"",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run smoke",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "release": "npx --yes @marianmeres/release@^2.2.0 --before-commit \"node scripts/sync-version.ts\"",
    "publish:jsr": "pnpm run test:deno && deno publish --no-check --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "dependencies": {
    "@marianmeres/clog": "^3.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
